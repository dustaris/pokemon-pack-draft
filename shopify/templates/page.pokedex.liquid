{%- comment -%}
  Pokédex Pack Draft game page. Assign a page (handle "pokedex") to the "pokedex" template.
  Signed-in customers get a short-lived token: "<customer id>.<unix time>.<hmac>", signed with the same secret as the
  pokedex-saves Cloudflare Worker's PD_SECRET. __PD_SECRET__ is filled in by build/make_theme.sh (never commit the real value).
{%- endcomment -%}
{%- liquid
  assign pd_token = ''
  if customer
    assign pd_ts = 'now' | date: '%s'
    assign pd_payload = customer.id | append: '.' | append: pd_ts
    assign pd_sig = pd_payload | hmac_sha256: '__PD_SECRET__'
    assign pd_token = pd_payload | append: '.' | append: pd_sig
  endif
  assign pd_login = '/account/login?return_url=' | append: request.path
-%}
{%- if customer and customer.accepts_marketing == false -%}
  <div id="pd-subscribe" hidden>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[email]" value="{{ customer.email | escape }}">
      <input type="hidden" name="contact[tags]" value="newsletter,pokedex-game">
    {%- endform -%}
  </div>
{%- endif -%}
<div class="pokedex-game" style="max-width:1200px;margin:0 auto;padding:0 8px">
  <iframe id="pokedex-frame" src="https://dustaris.github.io/pokemon-pack-draft/?v={{ 'now' | date: '%Y%m%d%H%M' }}" title="Pokédex Pack Draft"
    style="display:block;width:100%;height:calc(100vh - 120px);min-height:640px;border:0;border-radius:12px"
    allow="clipboard-write"></iframe>
</div>
<script>
  (function () {
    var frame = document.getElementById('pokedex-frame');
    var GAME = 'https://dustaris.github.io';
    var justPosted = /[?&]customer_posted=true/.test(location.search);
    var msg = {
      type: 'pd-auth',
      loginUrl: {{ pd_login | json }},
      auth: {% if customer %}{ token: {{ pd_token | json }}, name: {{ customer.first_name | json }} }{% else %}null{% endif %},
      subscribed: {% if customer and customer.accepts_marketing %}true{% else %}false{% endif %} || justPosted
    };
    window.addEventListener('message', function (e) {
      if (e.origin !== GAME || e.source !== frame.contentWindow || !e.data) return;
      if (e.data.type === 'pd-hello') frame.contentWindow.postMessage(msg, GAME);
      // The player confirmed the opt-in inside the game: submit Shopify's own newsletter form for their email
      if (e.data.type === 'pd-subscribe') { var f = document.querySelector('#pd-subscribe form'); if (f) f.submit(); }
    });
  })();
</script>
